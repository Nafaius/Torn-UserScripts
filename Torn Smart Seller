// ==UserScript==
// @name         Torn Smart Seller
// @namespace    Nuntius [4448332]
// @version      2.0.1
// @description  Automatically prepares Item Market quantities and prices from RRP using local rules.
// @author       Nael
// @match        https://www.torn.com/page.php?sid=ItemMarket*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_deleteValue
// @run-at       document-idle
// @license      MIT
// ==/UserScript==

(function () {
    'use strict';

    const STORAGE = {
        state: 'tornSmartSeller_state',
        autoPrepare: 'tornSmartSeller_autoPrepare',
        collapsed: 'tornSmartSeller_collapsed',
        pricePercent: 'tornSmartSeller_pricePercent'
    };

    const RULES = {
        SELL_ALL: { label: 'Sell all', color: '#43a047' },
        KEEP_ONE: { label: 'Keep 1', color: '#f9a825' },
        NEVER_SELL: { label: 'Never sell', color: '#e53935' }
    };


    function emptyState() {
        return { version: 1, items: {} };
    }

    function normalizeState(value) {
        const result = value && typeof value === 'object' ? value : emptyState();
        if (!result.items || typeof result.items !== 'object' || Array.isArray(result.items)) {
            result.items = {};
        }
        result.version = 1;
        return result;
    }

    let state = normalizeState(GM_getValue(STORAGE.state, emptyState()));
    let panel = null;
    let observer = null;
    let routeWatcher = null;
    let active = false;
    let scanScheduled = false;
    const seenThisSession = new Map();
    const naturalSlotTransforms = new Map();

    function saveState() {
        GM_setValue(STORAGE.state, state);
    }

    function getAutoPrepare() {
        return GM_getValue(STORAGE.autoPrepare, true) !== false;
    }

    function getPricePercent() {
        const value = Number(GM_getValue(STORAGE.pricePercent, 5));
        return Number.isFinite(value) ? value : 5;
    }

    function setPricePercent(value) {
        GM_setValue(STORAGE.pricePercent, value);
    }

    function isAddListingPage() {
        const params = new URLSearchParams(location.search);
        return location.pathname.endsWith('/page.php') &&
            params.get('sid') === 'ItemMarket' &&
            location.hash.startsWith('#/addListing') &&
            !location.hash.includes('/confirm');
    }

    function injectStyles() {
        if (document.getElementById('tss-style')) return;
        const style = document.createElement('style');
        style.id = 'tss-style';
        style.textContent = `
            #tss-panel {
                position: fixed;
                right: 12px;
                bottom: 72px;
                z-index: 2147483000;
                width: 320px;
                max-height: 78vh;
                overflow: hidden;
                color: #eee;
                background: #1c1c1c;
                border: 1px solid #4a4a4a;
                border-radius: 8px;
                box-shadow: 0 8px 26px rgba(0,0,0,.48);
                font: 12px Arial, Helvetica, sans-serif;
            }
            #tss-panel.tss-collapsed .tss-body { display: none; }
            #tss-panel .tss-header {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 8px 9px;
                background: linear-gradient(#363636, #262626);
                border-bottom: 1px solid #444;
                user-select: none;
            }
            #tss-panel .tss-title { flex: 1; font-weight: bold; }
            #tss-panel button {
                cursor: pointer;
                color: #eee;
                background: #343434;
                border: 1px solid #555;
                border-radius: 5px;
            }
            #tss-panel button:hover { filter: brightness(1.18); }
            #tss-collapse { min-width: 27px; height: 25px; }
            #tss-panel .tss-body {
                max-height: calc(78vh - 42px);
                overflow-y: auto;
                padding: 9px;
            }
            #tss-status {
                margin-bottom: 8px;
                padding: 6px 7px;
                line-height: 1.35;
                color: #ccc;
                background: #292929;
                border-radius: 5px;
            }
            #tss-status.ok { color: #b9f6ca; }
            #tss-status.warn { color: #ffe082; }
            #tss-status.error { color: #ffb3b3; }
            .tss-stats {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 5px;
                margin-bottom: 9px;
            }
            .tss-stat {
                padding: 5px 3px;
                text-align: center;
                background: #292929;
                border-radius: 5px;
            }
            .tss-stat strong {
                display: block;
                font-size: 14px;
                color: #fff;
            }
            .tss-row {
                display: flex;
                align-items: center;
                gap: 6px;
                margin: 7px 0;
            }
            .tss-row label { flex: 1; }
            .tss-row input[type="text"] {
                box-sizing: border-box;
                width: 86px;
                padding: 5px 6px;
                color: #eee;
                background: #111;
                border: 1px solid #555;
                border-radius: 4px;
            }
            .tss-actions {
                display: flex;
                gap: 5px;
                margin: 8px 0;
            }
            .tss-actions button { flex: 1; padding: 6px 5px; }
            .tss-section {
                margin-top: 10px;
                padding-top: 9px;
                border-top: 1px solid #444;
            }
            .tss-section-title {
                margin-bottom: 6px;
                font-weight: bold;
                color: #ddd;
            }
            #tss-data {
                box-sizing: border-box;
                width: 100%;
                min-height: 82px;
                resize: vertical;
                padding: 6px;
                color: #eee;
                background: #111;
                border: 1px solid #555;
                border-radius: 4px;
                font: 10px Consolas, monospace;
            }
            .tss-note {
                margin-top: 4px;
                color: #999;
                font-size: 10px;
                line-height: 1.35;
            }
            .tss-item-select {
                flex: 0 0 auto;
                width: 104px;
                height: 25px;
                margin: 0 5px;
                padding: 2px 4px;
                cursor: pointer;
                color: #f2f2f2 !important;
                background: #292929 !important;
                border: 1px solid #555 !important;
                border-radius: 5px;
                font-size: 11px;
                color-scheme: dark;
            }
            .tss-item-select option {
                color: #f2f2f2 !important;
                background: #242424 !important;
            }
            @keyframes tss-pulse {
                0%, 100% { filter: brightness(1); background-color: rgba(255,193,7,0); }
                50% { filter: brightness(1.18); background-color: rgba(255,193,7,.10); }
            }
            .tss-unclassified-row {
                outline: none !important;
                box-shadow: none !important;
                animation: tss-pulse 1.35s ease-in-out infinite !important;
